// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String
  email String @unique
  hashed_password String
  role String
  specialty String?

  created_tickets Ticket[] @relation("CreatedTickets")
  assigned_tickets Ticket[] @relation("AssignedTickets")
}

model Ticket {
  id String @id @default(uuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String
  priority Int
  status String
  description String

  created_by_id String
  created_by User @relation("CreatedTickets", fields: [created_by_id], references: [id])

  assigned_to_id String?
  assigned_to User? @relation("AssignedTickets", fields: [assigned_to_id], references: [id])

  machine_id String
  machine Machine @relation(fields: [machine_id], references: [id])

  histories TicketHistory[]
}

model TicketHistory {
  id String @id @default(uuid())

  created_at DateTime @default(now())

  action String
  description String
  actor_id String?
  actor_name String?

  ticket_name String?
  ticket_machine String?

  ticket_id String?
  ticket Ticket? @relation(fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([ticket_id])
}

model Machine {
  id String @id @default(uuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String
  type String
  brand String?
  tickets Ticket[]
}
